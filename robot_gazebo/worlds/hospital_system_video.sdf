            <clip><near>0.1</near><far>20</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>2</update_rate>
          <topic>/overview_cam/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>

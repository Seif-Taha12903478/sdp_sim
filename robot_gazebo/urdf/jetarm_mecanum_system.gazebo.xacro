<?xml version="1.0" encoding="utf-8"?>
<!-- generated by tools/make_system_world.py (hospital system): the robot of
     jetarm_mecanum.gazebo.xacro plus one DetachableJoint (assisted grasp weld) per
     pharmacy container med_<slot>. Each weld forms when its container FIRST appears
     (scripts/pharmacy.py spawns them after the robot and releases every weld at once,
     confirmed on /med_<slot>/attached). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
  <xacro:include filename="$(find robot_gazebo)/urdf/jetarm_mecanum.gazebo.xacro"/>
  <gazebo>
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link5</parent_link>
      <child_model>med_S1</child_model>
      <child_link>body</child_link>
      <attach_topic>/med_S1/attach</attach_topic>
      <detach_topic>/med_S1/detach</detach_topic>
      <output_topic>/med_S1/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link5</parent_link>
      <child_model>med_S2</child_model>
      <child_link>body</child_link>
      <attach_topic>/med_S2/attach</attach_topic>
      <detach_topic>/med_S2/detach</detach_topic>
      <output_topic>/med_S2/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link5</parent_link>
      <child_model>med_S3</child_model>
      <child_link>body</child_link>
      <attach_topic>/med_S3/attach</attach_topic>
      <detach_topic>/med_S3/detach</detach_topic>
      <output_topic>/med_S3/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link5</parent_link>
      <child_model>med_S4</child_model>
      <child_link>body</child_link>
      <attach_topic>/med_S4/attach</attach_topic>
      <detach_topic>/med_S4/detach</detach_topic>
      <output_topic>/med_S4/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link5</parent_link>
      <child_model>med_S5</child_model>
      <child_link>body</child_link>
      <attach_topic>/med_S5/attach</attach_topic>
      <detach_topic>/med_S5/detach</detach_topic>
      <output_topic>/med_S5/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>link5</parent_link>
      <child_model>med_S6</child_model>
      <child_link>body</child_link>
      <attach_topic>/med_S6/attach</attach_topic>
      <detach_topic>/med_S6/detach</detach_topic>
      <output_topic>/med_S6/attached</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </gazebo>
</robot>

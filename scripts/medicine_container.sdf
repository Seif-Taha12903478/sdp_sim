<?xml version="1.0"?>
<sdf version="1.7">
  <model name="medicine_container">
    <link name="body">
      <!-- 30 g, 30 mm diameter x 60 mm tall cylinder.
           Ixx=Iyy=m(3r^2+h^2)/12, Izz=m r^2/2 -->
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>1.07e-5</ixx><iyy>1.07e-5</iyy><izz>3.4e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.015</radius><length>0.06</length></cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
          <contact><ode><kp>1e6</kp><kd>1</kd><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="bottle">
        <geometry>
          <cylinder><radius>0.015</radius><length>0.06</length></cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="cap">
        <pose>0 0 0.036 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.017</radius><length>0.012</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.3 0.9 1</ambient>
          <diffuse>0.1 0.3 0.9 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
